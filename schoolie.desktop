[Desktop Entry]
Version=1.0
Type=Application
Name=Schoolie Cost Tracker
GenericName=Schoolie
Comment=Track schoolie conversion costs — free on-device receipt scans
# After install, scripts/install-desktop-launcher.sh rewrites Exec with absolute paths.
