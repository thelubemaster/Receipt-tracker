{
  "name": "schoolie-tracker",
  "private": true,
  "version": "1.35.2",
  "description": "Project Cost Tracker — free on-device receipts by project",
  "author": "Project Cost Tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelubemaster/Receipt-tracker.git"
  },
  "homepage": "https://thelubemaster.github.io/Receipt-tracker/",
  "bugs": {
    "url": "https://github.com/thelubemaster/Receipt-tracker/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4190",
    "start": "bash scripts/ensure-running.sh",
    "start:android": "node scripts/serve-android.mjs",
    "apk": "bash scripts/build-apk.sh",
    "apk:pack": "bash scripts/pack-install-zip.sh",
    "apk:update": "npm run build && node -e \"require('child_process').execSync('cd dist && zip -qr downloads/web-update.zip . -x downloads/project-cost-tracker.apk -x downloads/web-update.zip',{stdio:'inherit'})\"",
    "stop": "bash scripts/stop-server.sh",
    "test": "vitest run",
    "app": "bash scripts/run-desktop.sh",
    "app:dev": "SCHOOLIE_DEV=1 npx electron .",
    "app:icon": "bash scripts/install-desktop-launcher.sh",
    "app:install-icon": "bash scripts/install-desktop-launcher.sh",
    "app:pack": "npm run build && electron-builder --linux dir AppImage",
    "app:pack:deb": "npm run build && electron-builder --linux deb"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-updater": "^7.50.2",
    "@huggingface/transformers": "^4.2.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.schoolie.tracker",
    "productName": "Project Cost Tracker",
    "copyright": "Free · on-device",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/pwa-512.png",
        "to": "pwa-512.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Office",
      "icon": "public/pwa-512.png",
      "synopsis": "Track project costs with free on-device receipt AI"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/pwa-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/pwa-512.png",
      "category": "public.app-category.finance"
    }
  }
}
